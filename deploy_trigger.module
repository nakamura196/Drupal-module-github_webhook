<?php

/**
 * @file
 * Hook implementations for the Deploy Trigger module.
 */

use Drupal\Core\Entity\EntityInterface;

/**
 * Implements hook_locale_translation_projects_alter().
 *
 * Registers this module's local translation files so Drupal can
 * automatically import them regardless of the module's install path.
 */
function deploy_trigger_locale_translation_projects_alter(&$projects) {
  $module_handler = \Drupal::service('module_handler');
  $module_path = $module_handler->getModule('deploy_trigger')->getPath();
  $projects['deploy_trigger'] = [
    'info' => [
      'interface translation project' => 'deploy_trigger',
      'interface translation server pattern' => $module_path . '/translations/%language.po',
    ],
  ];
}

/**
 * Implements hook_entity_insert().
 */
function deploy_trigger_entity_insert(EntityInterface $entity) {
  _deploy_trigger_auto_trigger($entity);
}

/**
 * Implements hook_entity_update().
 */
function deploy_trigger_entity_update(EntityInterface $entity) {
  _deploy_trigger_auto_trigger($entity);
}

/**
 * Triggers deploys automatically when a node of a configured type is saved.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The entity being saved.
 */
function _deploy_trigger_auto_trigger(EntityInterface $entity) {
  // Only act on node entities.
  if ($entity->getEntityTypeId() !== 'node') {
    return;
  }

  $config = \Drupal::config('deploy_trigger.settings');

  // Check if auto trigger is enabled.
  if (!$config->get('auto_trigger_enabled')) {
    return;
  }

  // Check if this content type is configured for auto trigger.
  $content_types = $config->get('auto_trigger_content_types') ?? [];
  $bundle = $entity->bundle();
  if (!in_array($bundle, $content_types)) {
    return;
  }

  // Trigger GitHub repositories.
  $auto_trigger_repos = $config->get('auto_trigger_repositories') ?? [];
  $repositories = $config->get('repositories') ?? [];

  if (!empty($auto_trigger_repos) && !empty($repositories)) {
    /** @var \Drupal\deploy_trigger\Service\GitHubTriggerService $github_service */
    $github_service = \Drupal::service('deploy_trigger.github_trigger');

    foreach ($auto_trigger_repos as $repo_index) {
      if (!isset($repositories[$repo_index])) {
        continue;
      }

      $repository = $repositories[$repo_index];
      $label = $repository['owner'] . '/' . $repository['repo'];

      $success = $github_service->triggerRepository($repository);
      if ($success) {
        \Drupal::logger('deploy_trigger')->info('Auto-triggered GitHub deploy for @repository on @bundle node "@title".', [
          '@repository' => $label,
          '@bundle' => $bundle,
          '@title' => $entity->label(),
        ]);
      }
      else {
        \Drupal::logger('deploy_trigger')->error('Failed to auto-trigger GitHub deploy for @repository on @bundle node "@title".', [
          '@repository' => $label,
          '@bundle' => $bundle,
          '@title' => $entity->label(),
        ]);
      }
    }
  }

  // Trigger Vercel projects.
  $auto_trigger_vercel = $config->get('auto_trigger_vercel_projects') ?? [];
  $vercel_projects = $config->get('vercel_projects') ?? [];

  if (!empty($auto_trigger_vercel) && !empty($vercel_projects)) {
    /** @var \Drupal\deploy_trigger\Service\VercelTriggerService $vercel_service */
    $vercel_service = \Drupal::service('deploy_trigger.vercel_trigger');

    foreach ($auto_trigger_vercel as $project_index) {
      if (!isset($vercel_projects[$project_index])) {
        continue;
      }

      $project = $vercel_projects[$project_index];
      $label = $project['label'] ?: ('Vercel project ' . $project_index);

      $result = $vercel_service->triggerProject($project);
      if ($result['success']) {
        \Drupal::logger('deploy_trigger')->info('Auto-triggered Vercel deploy for @project on @bundle node "@title".', [
          '@project' => $label,
          '@bundle' => $bundle,
          '@title' => $entity->label(),
        ]);
      }
      else {
        \Drupal::logger('deploy_trigger')->error('Failed to auto-trigger Vercel deploy for @project on @bundle node "@title".', [
          '@project' => $label,
          '@bundle' => $bundle,
          '@title' => $entity->label(),
        ]);
      }
    }
  }
}
