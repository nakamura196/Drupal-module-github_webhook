# --- Routing / Tab / Menu titles ---

msgid "Deploy Trigger"
msgstr "デプロイトリガー"

msgid "Trigger"
msgstr "トリガー"

msgid "GitHub Repositories"
msgstr "GitHub リポジトリ"

msgid "Vercel Projects"
msgstr "Vercel プロジェクト"

msgid "Auto Trigger"
msgstr "自動トリガー"

# --- Permissions ---

msgid "Administer Deploy Trigger"
msgstr "デプロイトリガーの管理"

msgid "Configure repositories, projects, tokens, and auto-trigger settings."
msgstr "リポジトリ、プロジェクト、トークン、自動トリガーの設定を変更します。"

msgid "Trigger Deploy"
msgstr "デプロイのトリガー"

msgid "Trigger deployments on GitHub Actions and Vercel."
msgstr "GitHub Actions と Vercel のデプロイをトリガーします。"

# --- TriggerForm ---

msgid "Select Deploy Target"
msgstr "デプロイターゲットを選択"

msgid "- Select a target -"
msgstr "- ターゲットを選択 -"

msgid "No deploy targets configured."
msgstr "デプロイターゲットが設定されていません。"

msgid "Loading status..."
msgstr "ステータスを読み込み中..."

# --- GitHub trigger/cancel messages ---

msgid "GitHub webhook triggered successfully for @repository."
msgstr "@repository の GitHub Webhook を正常にトリガーしました。"

msgid "Failed to trigger GitHub webhook for @repository. Please contact an administrator."
msgstr "@repository の GitHub Webhook のトリガーに失敗しました。管理者にお問い合わせください。"

msgid "Workflow run cancelled."
msgstr "ワークフロー実行をキャンセルしました。"

msgid "Token does not have permission to cancel workflow runs. Update the token with Actions read/write permission."
msgstr "トークンにワークフロー実行をキャンセルする権限がありません。Actions の読み取り/書き込み権限を持つトークンに更新してください。"

msgid "This workflow run has already completed and cannot be cancelled."
msgstr "このワークフロー実行は既に完了しており、キャンセルできません。"

msgid "Failed to cancel workflow run."
msgstr "ワークフロー実行のキャンセルに失敗しました。"

# --- Vercel trigger/cancel messages ---

msgid "Vercel deploy triggered successfully for @project."
msgstr "@project の Vercel デプロイを正常にトリガーしました。"

msgid "Failed to trigger Vercel deploy for @project. Please contact an administrator."
msgstr "@project の Vercel デプロイのトリガーに失敗しました。管理者にお問い合わせください。"

msgid "Deployment cancelled."
msgstr "デプロイをキャンセルしました。"

msgid "Token does not have permission to cancel deployments."
msgstr "トークンにデプロイをキャンセルする権限がありません。"

msgid "Deployment not found."
msgstr "デプロイが見つかりません。"

msgid "Failed to cancel deployment."
msgstr "デプロイのキャンセルに失敗しました。"

# --- SettingsForm (GitHub) ---

msgid "Repository @row"
msgstr "リポジトリ @row"

msgid "Label"
msgstr "ラベル"

msgid "Display name for this repository. If empty, owner/repo will be used."
msgstr "リポジトリの表示名。空欄の場合は owner/repo が使われます。"

msgid "Owner"
msgstr "オーナー"

msgid "Enter the owner of the GitHub repository."
msgstr "GitHub リポジトリのオーナーを入力してください。"

msgid "Repo"
msgstr "リポジトリ"

msgid "Enter the name of the GitHub repository."
msgstr "GitHub リポジトリ名を入力してください。"

msgid "Token Source"
msgstr "トークンソース"

msgid "Manual input"
msgstr "手動入力"

msgid "Key module"
msgstr "Key モジュール"

msgid "Choose how to provide the GitHub token."
msgstr "GitHub トークンの提供方法を選択してください。"

msgid "GitHub Token"
msgstr "GitHub トークン"

msgid "A token is already saved. Leave blank to keep the current token."
msgstr "トークンは保存済みです。現在のトークンを維持する場合は空欄のままにしてください。"

msgid "Enter your GitHub personal access token. A fine-grained token with minimal permissions is recommended."
msgstr "GitHub パーソナルアクセストークンを入力してください。最小限の権限を持つ Fine-grained トークンの使用を推奨します。"

msgid "Key"
msgstr "キー"

msgid "- Select a key -"
msgstr "- キーを選択 -"

msgid "Select a key that contains the GitHub token."
msgstr "GitHub トークンを含むキーを選択してください。"

msgid "Event Type"
msgstr "イベントタイプ"

msgid "Enter the event type to trigger the webhook."
msgstr "Webhook をトリガーするイベントタイプを入力してください。"

msgid "Workflow File"
msgstr "ワークフローファイル"

msgid "Optional. The workflow filename (e.g. deploy.yml) to filter status display. Leave blank to show all repository_dispatch runs."
msgstr "任意。ステータス表示を絞り込むワークフローファイル名（例: deploy.yml）。空欄の場合はすべての repository_dispatch 実行を表示します。"

msgid "Remove repository"
msgstr "リポジトリを削除"

msgid "Add repository"
msgstr "リポジトリを追加"

msgid "Submit"
msgstr "保存"

# --- VercelSettingsForm ---

msgid "Project @row"
msgstr "プロジェクト @row"

msgid "Display name for this Vercel project."
msgstr "この Vercel プロジェクトの表示名。"

msgid "Deploy Hook URL"
msgstr "デプロイフック URL"

msgid "A Deploy Hook URL is already saved. Leave blank to keep the current URL."
msgstr "デプロイフック URL は保存済みです。現在の URL を維持する場合は空欄のままにしてください。"

msgid "Enter the Vercel Deploy Hook URL. This URL is a secret and will be stored securely."
msgstr "Vercel のデプロイフック URL を入力してください。この URL は秘密情報として安全に保存されます。"

msgid "Project ID"
msgstr "プロジェクト ID"

msgid "Vercel project ID for status monitoring. Leave blank if you only need to trigger deploys."
msgstr "ステータス監視用の Vercel プロジェクト ID。デプロイのトリガーのみの場合は空欄で構いません。"

msgid "Choose how to provide the Vercel API token."
msgstr "Vercel API トークンの提供方法を選択してください。"

msgid "Vercel Token"
msgstr "Vercel トークン"

msgid "Vercel API token for status monitoring and cancel operations. Not required for triggering deploys."
msgstr "ステータス監視とキャンセル操作用の Vercel API トークン。デプロイのトリガーには不要です。"

msgid "Select a key that contains the Vercel API token."
msgstr "Vercel API トークンを含むキーを選択してください。"

msgid "Remove project"
msgstr "プロジェクトを削除"

msgid "Add project"
msgstr "プロジェクトを追加"

# --- AutoTriggerForm ---

msgid "Enable Auto Trigger"
msgstr "自動トリガーを有効化"

msgid "Automatically trigger deploys when content is saved."
msgstr "コンテンツの保存時に自動的にデプロイをトリガーします。"

msgid "Content Types"
msgstr "コンテンツタイプ"

msgid "Select content types that will trigger deploys on save."
msgstr "保存時にデプロイをトリガーするコンテンツタイプを選択してください。"

msgid "No GitHub repositories configured. <a href=\":url\">Add repositories</a> first."
msgstr "GitHub リポジトリが設定されていません。先に<a href=\":url\">リポジトリを追加</a>してください。"

msgid "Select GitHub repositories to trigger when content is saved."
msgstr "コンテンツの保存時にトリガーする GitHub リポジトリを選択してください。"

msgid "No Vercel projects configured. <a href=\":url\">Add projects</a> first."
msgstr "Vercel プロジェクトが設定されていません。先に<a href=\":url\">プロジェクトを追加</a>してください。"

msgid "Select Vercel projects to trigger when content is saved."
msgstr "コンテンツの保存時にトリガーする Vercel プロジェクトを選択してください。"

# --- Status display (JS) ---

msgid "Recent Runs"
msgstr "最近の実行"

msgid "No recent runs."
msgstr "最近の実行はありません。"

msgid "Failed to load status."
msgstr "ステータスの読み込みに失敗しました。"

msgid "Status"
msgstr "ステータス"

msgid "Started"
msgstr "開始"

msgid "Duration"
msgstr "所要時間"

msgid "Cancel"
msgstr "キャンセル"

msgid "Cancelling..."
msgstr "キャンセル中..."

msgid "Triggering..."
msgstr "トリガー中..."

msgid "Failed to cancel."
msgstr "キャンセルに失敗しました。"

msgid "An error occurred while triggering the deploy."
msgstr "デプロイのトリガー中にエラーが発生しました。"

msgid "Please select a deploy target."
msgstr "デプロイターゲットを選択してください。"

# Status labels (shared between GitHub and Vercel)

msgid "Queued"
msgstr "待機中"

msgid "In progress"
msgstr "実行中"

msgid "Success"
msgstr "成功"

msgid "Failed"
msgstr "失敗"

msgid "Cancelled"
msgstr "キャンセル"

msgid "Completed"
msgstr "完了"

# Vercel-specific status labels

msgid "Building"
msgstr "ビルド中"

msgid "Initializing"
msgstr "初期化中"

msgid "Ready"
msgstr "完了"

msgid "Error"
msgstr "エラー"

# Time display

msgid "Just now"
msgstr "たった今"

msgid "@count min ago"
msgstr "@count 分前"

msgid "@count hr ago"
msgstr "@count 時間前"

msgid "@count days ago"
msgstr "@count 日前"
